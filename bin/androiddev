#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# androiddev: creación y compilación de apps Capacitor para Android.
# Copyright (C) 2026 Carlos Del Rosario
# shellcheck disable=SC1091

set -euo pipefail

ANDROIDDEV_VERSION="1.0.0"

resolve_script_dir() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -L "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
ANDROIDDEV_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
export ANDROIDDEV_ROOT

# Permite que --no-color funcione antes de cargar common.sh.
for _arg in "$@"; do
    case "$_arg" in
        --no-color) export ANDROIDDEV_NO_COLOR=1 ;;
        --yes | -y) export ANDROIDDEV_YES=1 ;;
        --dry-run) export ANDROIDDEV_DRY_RUN=1 ;;
        --debug) export ANDROIDDEV_DEBUG=1 ;;
    esac
done
unset _arg

# shellcheck source=../lib/common.sh
. "$ANDROIDDEV_ROOT/lib/common.sh"
# shellcheck source=../lib/os.sh
. "$ANDROIDDEV_ROOT/lib/os.sh"
# shellcheck source=../lib/java.sh
. "$ANDROIDDEV_ROOT/lib/java.sh"
# shellcheck source=../lib/sdk.sh
. "$ANDROIDDEV_ROOT/lib/sdk.sh"
# shellcheck source=../lib/project.sh
. "$ANDROIDDEV_ROOT/lib/project.sh"
# shellcheck source=../lib/build.sh
. "$ANDROIDDEV_ROOT/lib/build.sh"
# shellcheck source=../lib/shell.sh
. "$ANDROIDDEV_ROOT/lib/shell.sh"
# shellcheck source=../lib/config.sh
. "$ANDROIDDEV_ROOT/lib/config.sh"
# shellcheck source=../lib/doctor.sh
. "$ANDROIDDEV_ROOT/lib/doctor.sh"
# shellcheck source=../lib/menu.sh
. "$ANDROIDDEV_ROOT/lib/menu.sh"

usage() {
    cat <<EOF
androiddev $ANDROIDDEV_VERSION

Uso: androiddev [opciones] <comando> [argumentos]

Sin comando abre el menú interactivo (si hay terminal).

Comandos:
  doctor                 Diagnostica el sistema
  new <nombre>           Crea un proyecto Capacitor
  build                  Compila un APK debug
  shell install          Instala la integración en .bashrc/.zshrc
  shell remove           Quita la integración del shell
  shell status           Muestra dónde está instalada
  config [show|set]      Consulta o cambia la configuración
  env                    Muestra las rutas detectadas
  menu                   Abre el menú interactivo
  version                Muestra la versión
  help                   Muestra esta ayuda

Opciones globales:
  --no-color             Desactiva los colores
  --yes, -y              Responde sí a las confirmaciones
  --dry-run              Muestra los comandos sin ejecutarlos
  --debug                Muestra información de depuración
  --version, -V          Muestra la versión
  -h, --help             Muestra esta ayuda
EOF
}

cmd_version() {
    printf 'androiddev %s\n' "$ANDROIDDEV_VERSION"
}

cmd_env() {
    local sdk jdk
    sdk="$(find_android_sdk 2>/dev/null || true)"
    jdk="$(find_jdk21 2>/dev/null || true)"
    printf 'ANDROID_HOME=%s\n' "${sdk:-}"
    printf 'ANDROID_SDK_ROOT=%s\n' "${sdk:-}"
    printf 'JAVA_HOME=%s\n' "${jdk:-}"
    printf 'ANDROIDDEV_OUTPUT_DIR=%s\n' "${ANDROIDDEV_OUTPUT_DIR:-$(desktop_dir)}"
    printf 'ANDROIDDEV_CAPACITOR_VERSION=%s\n' "${ANDROIDDEV_CAPACITOR_VERSION:-7}"
}

main() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-color | --yes | -y | --dry-run | --debug | --version | -V | --help | -h)
                case "$1" in
                    --version | -V)
                        cmd_version
                        return 0
                        ;;
                    --help | -h)
                        usage
                        return 0
                        ;;
                    *) shift ;;
                esac
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "Opción global desconocida: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    load_config
    load_os_release

    local command="${1:-}"
    [ $# -gt 0 ] && shift

    case "$command" in
        "") 
            if is_tty; then
                menu_main
            else
                usage
            fi
            ;;
        menu)
            if is_tty; then
                menu_main
            else
                usage
            fi
            ;;
        doctor) cmd_doctor "$@" ;;
        new) cmd_new "$@" ;;
        build) cmd_build "$@" ;;
        shell) cmd_shell "$@" ;;
        config) cmd_config "$@" ;;
        env) cmd_env ;;
        version) cmd_version ;;
        help) usage ;;
        *)
            die "Comando desconocido: $command. Usa: androiddev help"
            ;;
    esac
}

main "$@"
